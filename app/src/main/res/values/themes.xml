<resources>
    <!-- Dark only, like Pickles: navy background, panels, Volt accent, Plus Jakarta Sans -->
    <style name="Theme.ScoreCounterApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/volt</item>
        <item name="colorOnPrimary">@color/navy</item>
        <item name="colorPrimaryContainer">@color/panel_high</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/side_right</item>
        <item name="colorOnSecondary">@color/navy</item>
        <item name="colorSecondaryContainer">@color/panel_high</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/panel_high</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/muted</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <!-- Only android:fontFamily here: the app-namespace fontFamily would override every view's own font -->
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ScoreCounter.Dialog</item>
    </style>

    <style name="ThemeOverlay.ScoreCounter.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/panel</item>
        <item name="colorPrimary">@color/volt</item>
        <item name="android:fontFamily">@font/jakarta</item>
    </style>

    <!-- Side panel: rounded 18dp, flat, Panel colour -->
    <style name="Widget.ScoreCounter.SidePanel" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Pickles "rally" button: solid colour, navy text, heavy weight -->
    <style name="Widget.ScoreCounter.BigButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">60dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/volt</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Pickles ToolButton: PanelHigh, white text, 14dp corners -->
    <style name="Widget.ScoreCounter.ToolButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/panel_high</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.ScoreCounter.NameField" parent="">
        <item name="android:background">@null</item>
        <item name="android:maxLength">10</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">textCapWords</item>
        <item name="android:imeOptions">actionDone|flagNoExtractUi</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- Scoreboard digits: Barlow Condensed ExtraBold, tabular figures (Pickles ScoreDigits) -->
    <style name="Widget.ScoreCounter.Digits" parent="">
        <item name="android:fontFamily">@font/barlow_condensed_extrabold</item>
        <item name="android:textSize">@dimen/score_digits</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.ScoreCounter.Tag" parent="">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
