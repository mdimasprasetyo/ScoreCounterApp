<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/main_menu"
        app:title="@string/app_name" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Scoreboard -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_left"
                    style="@style/Widget.ScoreCounter.ScoreCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/tap_to_score">
    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">
    
                        <EditText
                            android:id="@+id/edit_left_name"
                            style="@style/Widget.ScoreCounter.NameField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/left_side_name" />
    
                        <TextView
                            android:id="@+id/label_left_last"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/last_point"
                            android:textAllCaps="true"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="invisible" />
    
                        <TextView
                            android:id="@+id/score_left"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/default_score_left"
                            android:textAppearance="@style/TextAppearance.ScoreCounter.Score"
                            android:textColor="?attr/colorOnSurface" />
    
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/tap_to_score"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
    
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
    
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_left_down"
                                style="@style/Widget.ScoreCounter.RoundButton.Tonal"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="@string/remove_point"
                                app:icon="@drawable/ic_remove" />
    
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_left_up"
                                style="@style/Widget.ScoreCounter.RoundButton"
                                android:contentDescription="@string/add_point"
                                app:icon="@drawable/ic_add" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_right"
                    style="@style/Widget.ScoreCounter.ScoreCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/tap_to_score">
    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">
    
                        <EditText
                            android:id="@+id/edit_right_name"
                            style="@style/Widget.ScoreCounter.NameField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/right_side_name" />
    
                        <TextView
                            android:id="@+id/label_right_last"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/last_point"
                            android:textAllCaps="true"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="invisible" />
    
                        <TextView
                            android:id="@+id/score_right"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/default_score_right"
                            android:textAppearance="@style/TextAppearance.ScoreCounter.Score"
                            android:textColor="?attr/colorOnSurface" />
    
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/tap_to_score"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
    
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
    
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_right_down"
                                style="@style/Widget.ScoreCounter.RoundButton.Tonal"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="@string/remove_point"
                                app:icon="@drawable/ic_remove" />
    
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_right_up"
                                style="@style/Widget.ScoreCounter.RoundButton"
                                android:contentDescription="@string/add_point"
                                app:icon="@drawable/ic_add" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_undo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/undo_last_point"
                    app:icon="@drawable/ic_undo" />
        </LinearLayout>

        <!-- Sessions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/session_name">
    
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_session_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
    
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/save_session"
                    app:icon="@drawable/ic_save" />
    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/saved_sessions"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
    
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
    
                    <ListView
                        android:id="@+id/session_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:divider="@null"
                        android:dividerHeight="8dp" />
    
                    <TextView
                        android:id="@+id/empty_sessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="@string/no_sessions"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
